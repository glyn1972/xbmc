+  MatroskaFile    *matroska;
+
+  int num_tracks;
+  ulonglong track_mask;
+  MatroskaTrack *tracks;
+
+  char CSBuffer[4096];
+  unsigned BufferSize;
+
+  Chapter **editions;
+  AVEdition *aveditions;
+  int num_editions;
+
+  VirtualTimelineEntry *timeline;
+  int num_timeline;
+
+  int virtual_timeline;
+  int timeline_position;
+
+  Chapter *fake_edition;
+
+  MatroskaSegment **segments;
+  int num_segments;
